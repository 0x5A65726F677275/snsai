# Instagram Graph API (Meta Developer)
# https://developers.facebook.com/apps/
IG_USER_ID=
IG_ACCESS_TOKEN=

# Public image URLs required by Instagram API.
# Option A: ImgBB free hosting (https://api.imgbb.com/)
IMGBB_API_KEY=

# Option B: Your own CDN base URL (images already public)
# PUBLIC_MEDIA_BASE_URL=https://your-cdn.com/sns_ai/

# Meta Graph API version
GRAPH_API_VERSION=v21.0
